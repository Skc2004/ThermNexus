/* Allow users in the sudo/wheel group to permanently execute the ThermalNexus Engine 
 * natively without entering a root password prompt.
 * This guarantees an "Embedded Flow" application design completely masking Linux restrictions.
 */
polkit.addRule(function(action, subject) {
    if ((action.id == "org.freedesktop.policykit.exec" ||
         action.id == "org.freedesktop.polkit.exec") &&
        subject.isInGroup("sudo")) {
        
        // Exact strict match locking to our physical start engine
        if (action.lookup("command_line") && action.lookup("command_line").indexOf("thermalnexus-start.sh") !== -1) {
            return polkit.Result.YES;
        }
    }
});
